# ==============================================================================
# Telegram SEO & Website Visitor Intelligence Bot - Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL from Supabase, Neon, Railway, or AWS RDS.
# Example (Supabase Session/Transaction pooler or Direct):
# postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Bot token generated from @BotFather on Telegram (e.g., 123456789:ABCdefGhIJKlmNoPQRstuVWxYZ)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWxYZ

# Comma-separated list of Telegram User IDs authorized as administrators.
# Send a message to @userinfobot on Telegram to get your numeric ID.
# Example: 987654321 or 987654321,123456789
TELEGRAM_ADMIN_IDS=987654321

# Webhook secret token sent in X-Telegram-Bot-Api-Secret-Token for request verification.
# Generate any secure random string (e.g., 32 characters).
TELEGRAM_WEBHOOK_SECRET=your_random_secret_token_here_32_chars

# ------------------------------------------------------------------------------
# 3. WEBSITE & CRON CONFIGURATION (Required)
# ------------------------------------------------------------------------------
# Production website base URL (without trailing slash)
WEBSITE_URL=https://robinsonj.vercel.app

# Secret key used by Vercel Cron jobs to authorize automated scheduled triggers.
# Set this to match CRON_SECRET configured in Vercel project settings.
CRON_SECRET=your_random_cron_secret_key_here

# ------------------------------------------------------------------------------
# 4. GOOGLE SEARCH CONSOLE INTEGRATION (Optional - for organic keywords & clicks)
# ------------------------------------------------------------------------------
# The verified site URL in Google Search Console (include trailing slash or sc-domain: format)
GSC_SITE_URL=https://robinsonj.vercel.app/

# Option A: Service Account Email and Private Key
GOOGLE_CLIENT_EMAIL=robinson-seo-bot@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option B: Full Service Account JSON string (alternative to Option A)
# GOOGLE_APPLICATION_CREDENTIALS_JSON='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
